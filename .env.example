# Bind on all interfaces so other computers on the LAN can connect.
MIDNIGHT_HOST=0.0.0.0
# Friendly hostname: open http://midnightchats.local:5001 on the same network.
# Uses avahi-utils and avahi-daemon; leave empty to disable the alias.
MIDNIGHT_ALIAS=midnightchats.local
PORT=5001

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TIMEOUT=600
# Seconds to wait for /api/ps to confirm release after an unload request.
OLLAMA_UNLOAD_TIMEOUT=30

# Detailed rotating logs. Relative LOG_DIR paths resolve from the project root.
LOG_DIR=logs
LOG_LEVEL=INFO
# Rotate each file at approximately 10 MiB and keep five backups.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# Optional: set your LAN IPv4 address if automatic detection picks the wrong interface.
# MIDNIGHT_ADDRESS=192.168.1.81
# Optional: absolute path to a different SQLite database.
# MIDNIGHT_DATABASE=/absolute/path/to/chats.sqlite3
